# Copy to .env (never commit .env). All values are read from the environment.

PORT=8080
DB_PATH=/var/lib/daybook-plus/daybook-plus.db

# Which app and subscription this server sells (comma-separated)
PACKAGES=com.apklama.adhd
PRODUCTS=daybook_plus_monthly

# Bazaar developer API (Developer panel -> Developer API -> New client); refresh token: see README
BAZAAR_CLIENT_ID=
BAZAAR_CLIENT_SECRET=
BAZAAR_REFRESH_TOKEN=

# Your OpenAI-compatible AI server: base URL ending in /v1, its key, and the real model name
AI_URL=https://ai.example.com/v1
AI_KEY=
AI_MODEL=
# Longest answer allowed (0 = no cap)
AI_MAX_TOKENS=2048

# Fair use: AI messages per subscriber per day (UTC)
DAILY_LIMIT=100
# How often a subscription is checked with Bazaar again (hours)
RECHECK_HOURS=24
# /plus/verify calls per address per 10 minutes
VERIFY_PER_IP=20
# true only behind your own reverse proxy (reads X-Forwarded-For)
TRUST_PROXY=true
